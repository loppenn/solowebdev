{
  "version": 2,
  "framework": null,
  "devCommand": null,
  "builds": [
    {
      "src": "index.html",
      "use": "@vercel/static"
    },
    {
      "src": "api/submit.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/submit.js"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}